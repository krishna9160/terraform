complete Terraform configuration for creating an IAM user, group, and policy with all variables defined in a separate file:-

main.tf:-

provider "aws" {
  region = var.aws_region
}

# Create IAM User
resource "aws_iam_user" "user" {
  name = var.iam_user_name
  tags = {
    Environment = var.environment
  }
}

# Create IAM Group
resource "aws_iam_group" "group" {
  name = var.iam_group_name
}

# Attach User to Group
resource "aws_iam_group_membership" "group_membership" {
  name  = "${var.iam_group_name}-membership"
  users = [aws_iam_user.user.name]
  group = aws_iam_group.group.name
}

# Create IAM Policy
resource "aws_iam_policy" "policy" {
  name        = var.iam_policy_name
  description = "Custom IAM policy for S3 access"
  policy      = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action   = ["s3:ListBucket", "s3:GetObject"]
        Effect   = "Allow"
        Resource = [
          "arn:aws:s3:::${var.s3_bucket_name}",
          "arn:aws:s3:::${var.s3_bucket_name}/*"
        ]
      }
    ]
  })
}

# Attach Policy to Group
resource "aws_iam_policy_attachment" "policy_attach" {
  name       = "${var.iam_group_name}-policy-attach"
  policy_arn = aws_iam_policy.policy.arn
  groups     = [aws_iam_group.group.name]
}

Variables.tf:-

variable "aws_region" {
  description = "AWS region"
  type        = string
}

variable "iam_user_name" {
  description = "IAM user name"
  type        = string
}

variable "iam_group_name" {
  description = "IAM group name"
  type        = string
}

variable "iam_policy_name" {
  description = "IAM policy name"
  type        = string
}

variable "s3_bucket_name" {
  description = "S3 bucket name for policy"
  type        = string
}

variable "environment" {
  description = "Environment tag"
  type        = string
}

.tfvars:-

aws_region       = "us-east-1"
iam_user_name    = "my-iam-user"
iam_group_name   = "my-iam-group"
iam_policy_name  = "my-iam-policy"
s3_bucket_name   = "my-unique-s3-bucket"
environment      = "dev"

terraform init
terraform plan -var-file="terraform.tfvars"
terraform apply --auto-approve -var-file="terraform.tfvars"

✅ This setup includes:

IAM User
IAM Group
Custom IAM Policy for S3 access
Attach policy to group and add user to group
Variables for flexibility

