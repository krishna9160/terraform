########################################
# CodePipeline - main.tf
########################################
provider "aws" {
  region = var.aws_region
}

resource "aws_codepipeline" "pipeline" {
  name     = var.pipeline_name
  role_arn = var.service_role

  artifact_store {
    type     = "S3"
    location = var.artifact_bucket
  }

  stage {
    name = "Source"
    action {
      name             = "SourceAction"
      category         = "Source"
      owner            = "AWS"
      provider         = "CodeCommit"
      version          = "1"
      output_artifacts = ["source_output"]
      configuration = {
        RepositoryName = var.source_repo
        BranchName     = var.branch_name
      }
    }
  }
}

########################################
# CodePipeline - variables.tf
########################################
variable "aws_region" { type = string }
variable "pipeline_name" { type = string }
variable "service_role" { type = string }
variable "artifact_bucket" { type = string }
variable "source_repo" { type = string }
variable "branch_name" { type = string }

########################################
# CodePipeline - terraform.tfvars
########################################
